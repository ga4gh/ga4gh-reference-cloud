    <changeSet author="jadams" id="checkconstraint-tb-data-connect-table-column-table-name-format">
        <comment>Dot-separated lowercase SQL identifiers (letters, digits, underscores) so table names never require quoting in search queries</comment>
        <sql dbms="postgresql">
            ALTER TABLE data_connect_table ADD CONSTRAINT data_connect_table_table_name_format_check
                CHECK (table_name ~ '^[a-z_][a-z0-9_]*(\.[a-z_][a-z0-9_]*)*$');
        </sql>
        <rollback>
            <sql>ALTER TABLE data_connect_table DROP CONSTRAINT data_connect_table_table_name_format_check;</sql>
        </rollback>
    </changeSet>
    <changeSet author="jadams" id="create-function-set-updated-at">
        <sql dbms="postgresql" splitStatements="false">
            CREATE FUNCTION set_updated_at() RETURNS TRIGGER AS $$
            BEGIN
                NEW.updated_at = now();
                RETURN NEW;
            END;
            $$ LANGUAGE plpgsql;
        </sql>
        <rollback>
            <sql>DROP FUNCTION set_updated_at();</sql>
        </rollback>
    </changeSet>
    <changeSet author="jadams" id="trigger-tb-data-connect-table-type-set-updated-at">
        <sql dbms="postgresql">
            CREATE TRIGGER data_connect_table_type_set_updated_at
                BEFORE UPDATE ON data_connect_table_type
                FOR EACH ROW EXECUTE FUNCTION set_updated_at();
        </sql>
        <rollback>
            <sql>DROP TRIGGER data_connect_table_type_set_updated_at ON data_connect_table_type;</sql>
        </rollback>
    </changeSet>
    <changeSet author="jadams" id="trigger-tb-data-connect-table-set-updated-at">
        <sql dbms="postgresql">
            CREATE TRIGGER data_connect_table_set_updated_at
                BEFORE UPDATE ON data_connect_table
                FOR EACH ROW EXECUTE FUNCTION set_updated_at();
