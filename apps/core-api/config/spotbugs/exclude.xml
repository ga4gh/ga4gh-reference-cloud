<?xml version="1.0" encoding="UTF-8"?>
<!--
  project-wide spotbugs exclusions, each with a reason. suppress individual findings in code with
  @SuppressFBWarnings(value = "...", justification = "...") instead of adding to this file.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.10.5/spotbugs/etc/findbugsfilter.xsd">
    <!-- lombok-generated getters/setters on jpa entities and dtos store and return their (mutable) fields by design -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- find-sec-bugs inventory of every spring endpoint; informational, not a finding -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
</FindBugsFilter>
